{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "jsx": "react",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": ["src/**/*.test.*", "src/**/__tests__/**", "node_modules", "dist", "build"]
}