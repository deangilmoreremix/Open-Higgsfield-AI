# AI Outbound Outreach - Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI Configuration (users can use their own or platform-provided)
VITE_OPENAI_API_KEY=sk-your-openai-key

# MuAPI Configuration (optional, for video generation workflows)
VITE_MUAPI_API_KEY=your-muapi-key

# Application URL
PUBLIC_SITE_URL=http://localhost:5175

# Supabase Service Role Key (for Edge Functions - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Netlify Function Environment Variables
# These are set in Netlify dashboard, not here
STRIPE_SECRET_KEY= # REVED - Stripe integration removed
STRIPE_WEBHOOK_SECRET= # REVED - Stripe integration removed
