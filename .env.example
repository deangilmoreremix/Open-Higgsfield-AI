# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key for server-side operations (Netlify functions only)
# WARNING: This has admin privileges - never expose to client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# VIDEO DB API (Required for Netlify Functions)
# ============================================
# VideoDB provides AI video generation, voice, images, timeline composition
VIDEO_DB_API_KEY=your-videodb-api-key
VIDEO_DB_BASE_URL=https://api.videodb.io

# ============================================
# OPENAI API (Required for Netlify Functions)
# ============================================
# Used by director-backend for script generation and content creation
OPENAI_API_KEY=your-openai-api-key

# ============================================
# MUAPI CONFIGURATION (Optional)
# ============================================
# External MuAPI service endpoint
VITE_MUAPI_URL=https://api.muapi.ai
MUAPI_API_KEY=your-muapi-key-if-using-external-service

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_SENTRY_DSN=

# ============================================
# BUILD CONFIGURATION
# ============================================
VITE_APP_VERSION=1.0.0
VITE_BUILD_HASH=devel

