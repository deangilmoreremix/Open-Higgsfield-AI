{
  "name": "open-generative-ai",
  "description": "AI Video Agency — Professional AI-powered video editing studio with image, video, cinema and lip sync capabilities",
  "homepage": "https://github.com/deangilmoreremix/Open-Higgsfield-AI",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:next": "next dev",
    "dev:vite": "vite",
    "build": "vite build",
    "build:vite": "vite build",
    "build:all": "npm run build:remix-go && npm run build",
    "build:remix-go": "cd apps/remix-go && npm run build && cd ../.. && if [ -d apps/remix-go/dist ]; then mkdir -p public/apps/remix-go && cp -r apps/remix-go/dist/* public/apps/remix-go/; else echo '❌ Remix-go build failed: dist/ missing'; exit 1; fi",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "apps:validate": "node scripts/validate-apps.mjs",
    "apps:validate:strict": "node scripts/validate-apps.mjs --strict",
    "postinstall": "node scripts/setup-nextjs-bridges.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.17.6",
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "1.6.1",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.24",
    "canvas": "^3.2.3",
    "eslint": "^10.1.0",
    "eslint-config-next": "^15.5.18",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "next": "^15.5.18",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.37.2",
    "tailwindcss": "^4.3.0",
    "terser": "^5.27.0",
    "typescript": "^6.0.2",
    "vite": "^7.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.16.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.38.0",
    "interactjs": "^1.10.27",
    "konva": "^10.3.0",
    "lucide-react": "^1.8.0",
    "mobx-react-lite": "^4.1.1",
    "moment": "^2.30.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-konva": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
     "remark-gfm": "^4.0.1",
     "studio": "file:./packages/studio"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "trustedDependencies": [
      "better-sqlite3",
      "canvas",
      "electron",
      "electron-winstaller",
      "esbuild",
      "ffmpeg-static",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  }
}
